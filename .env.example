# Public site URL (no trailing slash). Used in confirmation emails and sitemap-related links.
PUBLIC_SITE_URL=http://localhost:4321

# Supabase (project URL + keys from Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Resend (API key + a from-address on a verified domain)
RESEND_API_KEY=
RESEND_FROM=Stick It Out <lessons@YOUR-DOMAIN>

# Optional: Cloudflare Pages also accepts the same names as secrets / env vars.
# Do not commit real values. Use .dev.vars for local Wrangler/Astro, and the
# Pages dashboard (or `wrangler secret put`) for production.
