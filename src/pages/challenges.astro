---
import LessonsLayout from '../layouts/LessonsLayout.astro';
---
<LessonsLayout title="Challenges | Stick It Out Lessons" description="Drum challenges that push your limits. Weekly lessons plus the rest of the library.">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14 sm:py-20">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-gel mb-2">Challenges</p>
    <h1 class="font-display text-4xl sm:text-5xl text-cue">Push your limits.</h1>
    <p class="mt-4 text-chrome leading-relaxed">
      Drum challenges come with membership, on top of a new lesson every week and the rest of the library. Join the founding waitlist to claim your spot.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/#home-email" class="tap inline-flex px-5 py-3 btn-gel text-sm">Join the founding waitlist</a>
      <a href="/#pricing" class="tap inline-flex px-5 py-3 border border-chrome/35 rounded-flyer text-sm font-semibold">See pricing</a>
    </div>
  </div>
</LessonsLayout>
