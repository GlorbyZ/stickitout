---
export const prerender = true;

import Marketing from '../layouts/Marketing.astro';
---

<Marketing title="Not found | Stick It Out" description="That page is not on the set list." noindex>
  <div class="mx-auto max-w-lg px-4 py-24 text-center sm:px-6">
    <h1 class="font-display text-6xl tracking-display text-cue">404</h1>
    <p class="mt-4 text-chrome">That cue is not in the book.</p>
    <a href="/" class="mt-8 inline-block text-gel hover:text-cue">Back to the house</a>
  </div>
</Marketing>
