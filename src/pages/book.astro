---
import BookLayout from '../layouts/BookLayout.astro';

const ORG = 'https://stickitoutdrums.com/#org';
const MIKE = 'https://stickitoutdrums.com/#mike';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG,
      name: 'Stick It Out',
      url: 'https://stickitoutdrums.com/',
      logo: 'https://stickitoutdrums.com/icons/icon-512.png',
    },
    {
      '@type': 'Person',
      '@id': MIKE,
      name: 'Mike Staus',
      jobTitle: 'Drummer / Instructor',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Berklee College of Music' },
    },
    {
      '@type': 'Book',
      name: 'Stick It Out',
      bookFormat: 'https://schema.org/EBook',
      author: { '@id': MIKE },
      publisher: { '@id': ORG },
      inLanguage: 'en-US',
      description:
        'A kick-and-hand coordination system for drummers. Patterns, independence, and how to practice them.',
      url: 'https://stickitoutdrums.com/book/',
      offers: {
        '@type': 'Offer',
        price: '19.99',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: 'https://stickitoutdrums.com/payment/',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://stickitoutdrums.com/' },
        { '@type': 'ListItem', position: 2, name: 'Book', item: 'https://stickitoutdrums.com/book/' },
      ],
    },
  ],
};
---
<BookLayout
  title="Stick It Out: The Drum Coordination Book (PDF) | Mike Staus"
  description="Stick It Out is Mike Staus's kick-and-hand coordination system for drummers. Demanding patterns, no filler. Instant PDF download, $19.99."
  ogImage="/img/social/og-book.jpg"
  ogAlt="Stick It Out. Rhythm is resilience. PDF $19.99."
  ogType="book"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16 grid lg:grid-cols-2 gap-12 items-center">
    <img
      src="/img/cover.jpg"
      alt="Stick It Out book cover"
      width="800"
      height="1000"
      fetchpriority="high"
      class="w-full max-w-md mx-auto border border-white/10"
    />
    <div>
      <p class="text-gel text-sm font-display tracking-[0.12em]">The book</p>
      <h1 class="font-display text-6xl sm:text-7xl text-cue leading-[0.9] mt-2">Stick It Out</h1>
      <p class="mt-4 text-xl text-cue">Rhythm is resilience.</p>
      <p class="mt-4 text-chrome text-[17px] leading-relaxed max-w-xl">
        A kick-and-hand coordination system. Patterns, independence, and how to practice them. No filler.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="/payment/" class="tap inline-flex items-center justify-center btn-gel px-6 py-3 text-sm">Buy the PDF, $19.99</a>
        <a href="/#home-email" class="tap inline-flex items-center justify-center px-6 py-3 text-sm text-chrome hover:text-cue">Join the founding waitlist →</a>
      </div>
      <p class="mt-3 text-xs text-chrome">Opens the checkout page. Payment is Stripe.</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16">
    <h2 class="font-display text-4xl text-cue">What it is</h2>
    <ul class="mt-4 space-y-2 text-chrome text-[17px] leading-relaxed list-disc pl-5">
      <li>Coordination patterns for kick and hands.</li>
      <li>Independence work you can take to a real kit.</li>
      <li>A way to practice them until they are yours.</li>
    </ul>
    <p class="mt-8 text-chrome">Print edition: summer.</p>
    <div class="mt-10 panel-card p-6">
      <h2 class="font-display text-3xl text-cue">The lessons are the weekly version</h2>
      <p class="mt-3 text-chrome">The founding annual plan includes this PDF. The membership is the ongoing practice.</p>
      <a href="/#home-email" class="tap mt-4 inline-flex btn-gel px-5 py-2 text-sm">Join the founding waitlist</a>
    </div>
  </section>
</BookLayout>
