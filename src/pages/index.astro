---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const ORG = 'https://stickitoutbook.com/#org';
const MIKE = 'https://stickitoutbook.com/#mike';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG,
      name: 'Stick It Out',
      url: 'https://stickitoutbook.com/',
      logo: 'https://stickitoutbook.com/icons/icon-512.png',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://stickitoutbook.com/#website',
      url: 'https://stickitoutbook.com/',
      name: 'Stick It Out',
      publisher: { '@id': ORG },
      inLanguage: 'en-US',
    },
    {
      '@type': 'Person',
      '@id': MIKE,
      name: 'Mike Staus',
      jobTitle: 'Drummer / Instructor',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Berklee College of Music' },
    },
    {
      '@type': 'Course',
      name: 'Stick It Out Lessons',
      description:
        'Stop practicing. Start training. Structured drum training for the whole drummer. Train with purpose. Get dangerous behind the kit.',
      provider: { '@id': ORG },
      instructor: { '@id': MIKE },
      inLanguage: 'en-US',
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'online',
        courseWorkload: 'PT10M',
      },
    },
    {
      '@type': 'Product',
      name: 'Stick It Out Lessons membership',
      description: 'Founding membership. A new lesson every week, the rest of the library, and drum challenges.',
      brand: { '@id': ORG },
      offers: {
        '@type': 'Offer',
        price: '19.99',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: 'https://stickitoutbook.com/',
      },
    },
  ],
};
---
<BaseLayout
  title="Stick It Out: Stop practicing. Start training."
  description="How good could you actually get at drums if you stopped guessing and started training with a purpose? Join the founding member waitlist."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/img/gym/hero-stage.png" fetchpriority="high" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <a class="skip" href="#main">Skip to content</a>

  <SiteHeader ctaHref="#home-email" heroOnly />

  <main id="main">
    <section id="hero" class="hero relative flex items-center justify-center text-center px-4">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="relative max-w-[920px] py-8 sm:py-10">
        <h1 class="font-display text-5xl sm:text-7xl md:text-8xl text-cue leading-[0.86]">
          <span class="block rise"><span>Stop practicing.</span></span>
          <span class="block rise"><span>Start training.</span></span>
        </h1>
        <p class="fade-seq d1 mt-5 text-[17px] sm:text-xl text-cue leading-[1.4] max-w-3xl mx-auto">
          How good could you actually get at drums if you stopped guessing and started training with a purpose?
        </p>
        <p class="fade-seq d1 mt-4 text-[15px] sm:text-[16px] text-chrome leading-[1.55] max-w-2xl mx-auto">
          Stick It Out is structured drum training built to develop the whole drummer. Technique, speed, coordination, endurance, creativity, musicality and confidence. Follow the weekly training, dive into the lesson catalog, take on challenges and put in the work.
        </p>
        <p class="fade-seq d1 mt-3 font-display text-2xl sm:text-3xl text-gel leading-[0.95]">
          Train with purpose. Push the bar. Get dangerous behind the kit.
        </p>
        <form id="home-capture" class="capture fade-seq d2 mt-8 mx-auto max-w-md text-left" novalidate>
          <label class="sr-only" for="home-email">Email</label>
          <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input
            id="home-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            inputmode="email"
            enterkeyhint="send"
            placeholder="you@email.com"
            class="w-full bg-blackout/80 border border-chrome/30 px-4 py-3 text-base text-cue focus:outline-none"
          />
          <button type="submit" id="home-submit" class="tap mt-3 w-full inline-flex items-center justify-center btn-gel px-6 py-3 text-base sheen">
            Join the founding waitlist
          </button>
          <p id="home-status" class="mt-3 text-sm min-h-5 text-center" role="status" aria-live="polite"></p>
          <p class="mt-2 text-xs text-chrome text-center">No card. We'll email you when founding spots open.</p>
        </form>
        <ul class="fade-seq d3 mt-10 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[13px] text-chrome">
          <li>Berklee-trained</li>
          <li>Touring + studio drummer</li>
          <li>Weekly drop + library</li>
          <li>Drum challenges</li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    background: var(--gel);
    color: var(--on-gel);
    padding: 0.4rem 0.7rem;
    z-index: 80;
  }
  .skip:focus { top: 0.5rem; }
  .hero {
    isolation: isolate;
    overflow-anchor: none;
    overflow: hidden;
    min-height: calc(100svh - 4rem);
    align-items: safe center;
    padding-bottom: 1.5rem;
  }
  #home-capture { scroll-margin-bottom: 35vh; }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: url('/img/gym/hero-stage.png') center 55% / cover no-repeat;
    transform: scale(1.06);
    animation: settle 2400ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  /* Vignette + floor fade so the headline always sits on near-black */
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 70% 60%, transparent 0%, rgba(12, 11, 10, 0.5) 70%, var(--blackout) 100%),
      linear-gradient(180deg, rgba(12, 11, 10, 0.86) 0%, rgba(12, 11, 10, 0.45) 38%, var(--blackout) 92%);
  }
  @keyframes settle {
    from { opacity: 0; transform: scale(1.1); }
    to { opacity: 1; transform: scale(1.06); }
  }

  /* Headline: mask-reveal per line, not a plain fade */
  .rise {
    clip-path: inset(0 0 -12% 0);
  }
  .rise > span {
    display: block;
    animation: lift 820ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .rise:nth-child(1) > span { animation-delay: 120ms; }
  .rise:nth-child(2) > span { animation-delay: 220ms; }
  .rise:nth-child(3) > span { animation-delay: 320ms; }
  @keyframes lift {
    from { opacity: 0; transform: translateY(108%); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fade-seq { animation: fadeSeq 700ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  .d1 { animation-delay: 420ms; }
  .d2 { animation-delay: 560ms; }
  .d3 { animation-delay: 680ms; }
  @keyframes fadeSeq {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .btn-gel {
    color: var(--on-gel);
    position: relative;
    overflow: hidden;
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 220ms ease;
  }
  .btn-gel:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(232, 163, 23, 0.26);
  }
  .btn-gel:active { transform: translateY(0) scale(0.985); }
  .sheen::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 45%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    transform: translateX(-100%) skewX(-12deg);
    opacity: 0;
  }
  .sheen:hover::after {
    animation: sheen 780ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes sheen {
    0% { transform: translateX(0) skewX(-12deg); opacity: 0; }
    12% { opacity: 1; }
    100% { transform: translateX(420%) skewX(-12deg); opacity: 0; }
  }
  #home-email:focus { border-color: var(--gel); box-shadow: 0 0 0 3px rgba(232, 163, 23, 0.25); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    .hero-bg { transform: scale(1); }
  }
</style>

<script>
  import { captureLead, joinWaitlist, setSessionEmail } from '../lib/lessons';

  const form = document.getElementById('home-capture') as HTMLFormElement | null;
  const input = document.getElementById('home-email') as HTMLInputElement | null;
  const status = document.getElementById('home-status');
  const button = document.getElementById('home-submit') as HTMLButtonElement | null;
  const label = button?.textContent || 'Join the founding waitlist';

  input?.addEventListener('blur', () => {
    if (!input.value) return;
    if (!input.checkValidity() && status) {
      status.textContent = 'Enter a real email address.';
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!input || !button || !status) return;
    if (!input.checkValidity()) {
      status.textContent = 'Enter a real email address.';
      return;
    }
    button.disabled = true;
    button.textContent = 'Saving…';
    const email = input.value.trim();
    const result = await captureLead({ email, source: 'waitlist', plan: 'monthly' });
    if (result.ok) {
      joinWaitlist(email.split('@')[0] || 'member', email, 'monthly');
      setSessionEmail(email);
      input.hidden = true;
      button.hidden = true;
      status.textContent = "You're on the founding waitlist. We'll email you when spots open.";
      status.className = 'mt-3 text-sm text-gel text-center';
    } else {
      status.textContent = "That didn't go through. Try again or DM Mike.";
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>
