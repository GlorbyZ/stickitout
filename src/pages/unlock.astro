---
import BookLayout from '../layouts/BookLayout.astro';
---
<BookLayout title="Download | Stick It Out" description="Download your Stick It Out PDF." noindex>
  <section class="max-w-xl mx-auto px-4 sm:px-6 py-20 text-center">
    <h1 class="font-display text-4xl text-cue">You&rsquo;re unlocked</h1>
    <p class="mt-3 text-chrome text-sm">Download the official PDF. Keep this page bookmarked.</p>
    <a
      href="/assets/Stick_It_Out_Official.pdf"
      class="tap mt-8 inline-flex btn-gel px-6 py-3 text-sm"
      download
    >
      Download PDF
    </a>
    <p class="mt-6 text-sm text-chrome">
      Want coaching too? <a href="/#home-email" class="text-gel font-semibold">Join the founding waitlist →</a>
    </p>
  </section>
</BookLayout>
