---
export const prerender = true;

import Marketing from '../layouts/Marketing.astro';
import PageHeader from '../components/PageHeader.astro';
import PricingTable from '../components/PricingTable.astro';
import { commerce } from '../lib/commerce';
---

<Marketing title="Pricing | Stick It Out Lessons" description="Monthly, biannual, and annual plans. Same access on every tier.">
  <PageHeader
    title="Pricing"
    lede="One plan, full access. Numbers come from the existing Lessons commerce config — not a new rate card."
  />
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <PricingTable />
    <div class="mt-8 text-center">
      <a
        href={commerce.joinHref()}
        class="tap inline-flex items-center justify-center rounded-sio bg-gel px-8 py-3.5 font-semibold text-on-gel hover:opacity-90"
      >
        Claim your spot
      </a>
    </div>
  </div>
</Marketing>
