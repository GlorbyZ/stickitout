---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogAlt?: string;
  ogType?: string;
  canonical?: string;
}
const {
  title,
  description = 'How good could you actually get at drums if you stopped guessing and started training with a purpose?',
  noindex = false,
  ogImage = '/img/social/og-home.jpg',
  ogAlt = 'Stick It Out. Stop practicing. Start training.',
  ogType = 'website',
  canonical,
} = Astro.props;

const site = Astro.site ?? new URL('https://stickitoutdrums.com');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index,follow,max-image-preview:large" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Stick It Out" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icons/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#E8A317" />

    <meta name="theme-color" content="#0C0B0A" />
    <meta name="theme-color" content="#0C0B0A" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0C0B0A" media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-navbutton-color" content="#0C0B0A" />
    <meta name="msapplication-TileColor" content="#0C0B0A" />
    <meta name="msapplication-TileImage" content="/icons/mstile-150.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Stick It Out" />
    <meta name="designer" content="Blaze Digital Design" />
    <link rel="author" href="https://blazedigitaldesign.com/" title="Blaze Digital Design" />
    <link rel="alternate" type="text/markdown" href="/credits.md" title="Studio credit (markdown)" />

    <script is:inline>
      // Gate scroll reveals so content is never stuck invisible if JS dies.
      document.documentElement.classList.add('js-ready');
      setTimeout(function () {
        document.documentElement.classList.add('reveal-failsafe');
      }, 2500);
    </script>
    <slot name="head" />
  </head>
  <body class="bg-blackout text-cue antialiased min-h-screen flex flex-col font-body">
    <slot />
  </body>
</html>
