---
import { faqItems } from '../data/faq';

interface Props {
  items?: typeof faqItems;
}

const { items = faqItems } = Astro.props;
---

<div class="space-y-3">
  {
    items.map((item, i) => (
      <details
        class="rounded-sio border border-chrome/20 bg-wings px-5 py-1"
        open={i === 0}
      >
        <summary class="tap flex cursor-pointer items-center justify-between gap-4 py-4 font-semibold text-cue">
          <span>{item.q}</span>
          <svg
            class="faq-chev h-5 w-5 shrink-0 text-chrome transition-transform"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" />
          </svg>
        </summary>
        <p class="pb-4 text-sm leading-relaxed text-chrome">{item.a}</p>
      </details>
    ))
  }
</div>
