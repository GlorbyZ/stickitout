---
interface Props {
  title: string;
  excerpt: string;
  week?: number;
  isFree?: boolean;
  href: string;
  cover?: string;
}

const { title, excerpt, week, isFree = false, href, cover = '/img/gym/kit.jpg' } = Astro.props;
---

<article class="group flex flex-col overflow-hidden rounded-sio border border-chrome/20 bg-wings">
  <a href={href} class="relative block aspect-16/10 overflow-hidden">
    <img
      src={cover}
      alt=""
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      loading="lazy"
    />
    {
      isFree && (
        <span class="absolute top-3 left-3 rounded-sio bg-gel px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide text-on-gel">
          Free
        </span>
      )
    }
  </a>
  <div class="flex flex-grow flex-col p-5">
    {
      week != null && (
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gel">Week {week}</p>
      )
    }
    <h3 class="font-display mt-1 text-2xl tracking-display text-cue">
      <a href={href} class="hover:text-gel">{title}</a>
    </h3>
    <p class="mt-2 flex-grow text-sm leading-relaxed text-chrome">{excerpt}</p>
  </div>
</article>
