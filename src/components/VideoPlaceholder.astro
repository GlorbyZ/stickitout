---
interface Props {
  title?: string;
  note?: string;
}

const {
  title = 'Lesson video',
  note = 'TODO: Mike’s explainer / lesson embed. No URL invented.',
} = Astro.props;
---

<div class="overflow-hidden rounded-sio border border-chrome/25 bg-blackout">
  <div class="flex aspect-video items-center justify-center bg-wings p-6 text-center">
    <div>
      <p class="font-display text-2xl tracking-display text-cue">{title}</p>
      <p class="mt-2 text-sm text-chrome">{note}</p>
    </div>
  </div>
</div>
