---
import { commerce } from '../lib/commerce';

const plans = commerce.planList();
const live = commerce.anyCheckoutLive();
---

<div class="grid items-stretch gap-4 sm:grid-cols-3">
  {
    plans.map((plan) => {
      const featured = plan.id === commerce.defaultPlanId;
      return (
        <a
          href={commerce.joinHref(plan.id)}
          class:list={[
            'flex min-h-[168px] flex-col justify-center rounded-sio border bg-wings p-7 text-center transition-colors',
            featured
              ? 'border-gel -translate-y-1 shadow-[0_18px_40px_color-mix(in_srgb,var(--sio-blackout)_70%,transparent)]'
              : 'border-chrome/25 hover:border-chrome/50',
          ]}
        >
          <h3 class="text-xs font-bold uppercase tracking-[0.22em] text-chrome">{plan.label}</h3>
          <p class="mt-4 text-[2rem] font-bold tracking-tight text-cue">
            {plan.priceLabel}{' '}
            <span class="text-base font-semibold text-chrome">{plan.interval}</span>
          </p>
          {plan.savings && <p class="mt-2 text-sm font-semibold text-chrome">{plan.savings}</p>}
          <p class="mt-3 text-xs font-semibold text-gel">Select plan →</p>
        </a>
      );
    })
  }
</div>
<p class="mt-6 text-center text-xs text-chrome">
  {
    live
      ? 'Encrypted checkout via Stripe. Cancel anytime on monthly.'
      : 'Stripe for /join is not live yet. Claim a waitlist seat — do not invent product IDs.'
  }
</p>
